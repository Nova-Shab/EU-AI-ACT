# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (SQLite für einfache Entwicklung)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# JWT Secret
JWT_SECRET=eu_ai_act_secret_key_development_only_change_in_production
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
